<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Escapa de Laburar</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- Ciudad de fondo de toda la página -->
  <canvas id="city"></canvas>

  <!-- Dibujo de la carita Verity, para repetirla en la tienda -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="vf" viewBox="0 0 20 20">
      <circle cx="10" cy="10" r="9" fill="#facc15" stroke="#b45309" stroke-width="1"/>
      <ellipse cx="7" cy="8" rx="1.1" ry="1.8" fill="#111"/>
      <ellipse cx="13" cy="8" rx="1.1" ry="1.8" fill="#111"/>
      <path d="M5.5 11.5Q10 16.5 14.5 11.5" stroke="#111" stroke-width="1.5" fill="none" stroke-linecap="round"/>
    </symbol>
  </svg>

  <main>

    <!-- Puntos, combo y récord -->
    <div class="bar">
      <div>
        <span class="lbl">Puntos</span>
        <span class="val" id="score">0</span>
      </div>
      <div id="combo">x1</div>
      <div style="text-align:right">
        <span class="lbl">Récord</span>
        <span class="val" id="best">0</span>
      </div>
    </div>

    <!-- Palas guardadas -->
    <div class="bar">
      <span class="lbl" style="color:var(--gold);font-weight:700">Tus palas</span>
      <div class="slots">
        <div class="slot"></div>
        <div class="slot"></div>
        <div class="slot"></div>
      </div>
      <button id="use" aria-label="Usar pala">Usar (Espacio)</button>
    </div>

    <!-- Zona de juego -->
    <div class="wrap" id="wrap">
      <canvas id="cv" width="460" height="540"></canvas>

      <!-- Pantalla de inicio -->
      <div class="ov" id="startOv">
        <h1>ESCAPA DE LABURAR</h1>
        <p class="how">
          Esquiva las palas que caen. Junta Veritys para subir el combo; el escudo aguanta un golpe
          y el reloj frena el tiempo. Cada pala dorada que agarres se guarda: úsala para romper todas
          las palas de la pantalla. Raras: Falsity (cara azul) vale 5 Veritys y Cruelty (cara roja)
          vale 10.
        </p>
        <button class="btn" id="startBtn">JUGAR</button>
      </div>

      <!-- Pantalla final -->
      <div class="ov hidden" id="overOv">
        <h1>¡TE TOCÓ LABURAR!</h1>
        <p id="fin">Puntaje final: 0</p>
        <p id="finBest">Mejor récord: 0</p>

        <div id="nameRow">
          <input id="nameIn" maxlength="12" placeholder="Tu nombre" autocomplete="off" aria-label="Tu nombre">
          <button class="btn" id="saveBtn">Guardar</button>
        </div>
        <p id="saveMsg"></p>

        <button class="btn" id="againBtn">REINTENTAR</button>
      </div>

      <!-- Pantalla de pausa -->
      <div class="ov hidden" id="pauseOv">
        <h1>PAUSA</h1>
        <p>Toca o pulsa P para seguir.</p>
      </div>
    </div>

    <!-- Controles y sonido -->
    <div class="foot">
      <span>← / → o A / D · arrastra · P pausa</span>
      <button id="mute">Sonido: sí</button>
    </div>

    <!-- Tienda -->
    <section class="shop">
      <div class="shophead">
        <h2>Tienda</h2>
        <div class="wallet" title="Tus Veritys">
          <svg class="vf"><use href="#vf"/></svg>
          <strong id="wal">0</strong>
        </div>
      </div>

      <div class="card">
        <div class="prev">
          <div class="prevbox" id="prevBox"></div>
        </div>
        <b>Tu imagen en el juego</b>
        <span>Reemplaza el rectángulo azul por cualquier foto tuya.</span>

        <!-- Antes de comprar -->
        <div id="buyBox">
          <div class="prog"><i id="progBar"></i></div>
          <span id="progTxt">0 de 67 Veritys</span>
          <button class="btn" id="buyBtn">
            Comprar por 67
            <svg class="vf"><use href="#vf"/></svg>
          </button>
        </div>

        <!-- Después de comprar -->
        <div id="skinCtl">
          <label class="btn up" for="imgIn">Elegir imagen</label>
          <input type="file" id="imgIn" accept="image/*" hidden>
          <button id="clrBtn">Quitar</button>
        </div>
      </div>

      <div class="card">
        <div class="prev">
          <div class="prevbg" id="bgPrev"></div>
        </div>
        <b>Tu fondo de atrás</b>
        <span>Cambia la ciudad de atrás por cualquier imagen que quieras.</span>

        <!-- Antes de comprar -->
        <div id="bgBuyBox">
          <div class="prog"><i id="bgProgBar"></i></div>
          <span id="bgProgTxt">0 de 123 Veritys</span>
          <button class="btn" id="bgBuyBtn">
            Comprar por 123
            <svg class="vf"><use href="#vf"/></svg>
          </button>
        </div>

        <!-- Después de comprar -->
        <div id="bgCtl">
          <label class="btn up" for="bgIn">Elegir fondo</label>
          <input type="file" id="bgIn" accept="image/*" hidden>
          <button id="bgClrBtn">Quitar</button>
        </div>
      </div>

      <p id="shopMsg"></p>
    </section>

    <!-- Clasificación -->
    <section class="board">
      <h2>Clasificación</h2>
      <p id="rankSrc">Solo en este dispositivo</p>
      <ol id="rank"></ol>
    </section>

  </main>

  <script src="game.js"></script>
</body>
</html>
